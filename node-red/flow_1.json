        "wires": []
    },
    {
        "id": "c8787ecc85142b6a",
        "type": "function",
        "z": "59a5949d73b8cc7f",
        "name": "function 2",
        "func": "const th = flow.get('hum_th') ?? 60;\nconst hys = 3;\n\nconst hum = parseFloat(msg.payload);\nconst board = msg.topic.split('/')[1];\n\nif (!Number.isFinite(hum)) {\n    node.warn(\"Invalid humidity value\");\n    return null;\n}\n\nlet alarms = flow.get('alarms') || {};\nconst before = Object.values(alarms).some(Boolean);\n\nif (hum > th) {\n    alarms[board] = true;\n} else if (hum < th - hys) {\n    alarms[board] = false;\n}\n\nflow.set('alarms', alarms);\n\nconst after = Object.values(alarms).some(Boolean);\n\n// Only publish when alarm state changes\nif (after === before) return null;\n\nreturn {\n    topic: \"esp32/alarm/humidity\",\n    payload: after ? \"1\" : \"0\",\n    retain: true\n};",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 420,
        "y": 500,
        "wires": [
            [
                "b5493402667dcb36"
            ]
        ]
    },
