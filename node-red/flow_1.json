    {
        "id": "78121d81bcdb6262",
        "type": "function",
        "z": "59a5949d73b8cc7f",
        "name": "function 1",
        "func": "const threshold = Number(msg.payload);\n\nif (!Number.isFinite(threshold)) {\n    node.warn(\"Invalid humidity threshold\");\n    return null;\n}\n\nflow.set(\"hum_th\", threshold);\n\nnode.status({\n    fill: \"green\",\n    shape: \"dot\",\n    text: \"Threshold: \" + threshold + \"%\"\n});\n\nnode.warn(\"New humidity threshold: \" + threshold);\n\nreturn null;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 400,
        "y": 280,
        "wires": [
            []
        ]
    },
    {
        "id": "b5493402667dcb36",
        "type": "mqtt out",
        "z": "59a5949d73b8cc7f",
        "name": "",
        "topic": "esp32/alarm/humidity",
        "qos": "",
        "retain": "",
        "respTopic": "",
        "contentType": "",
        "userProps": "",
        "correl": "",
        "expiry": "",
        "broker": "6c98f3c6e1c21e36",
