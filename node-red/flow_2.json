    "fn_th"
   ]
  ]
 },
 {
  "id": "fn_th",
  "type": "function",
  "z": "flow1",
  "name": "store threshold",
  "func": "flow.set('hum_th', Number(msg.payload));\nreturn null;",
  "outputs": 1,
  "timeout": 0,
  "noerr": 0,
  "initialize": "flow.set('hum_th', 60);",
  "finalize": "",
  "libs": [],
  "x": 370,
  "y": 220,
  "wires": [
   []
  ]
 },
 {
  "id": "fn_alarm",
  "type": "function",
  "z": "flow1",
  "name": "humidity alarm",
  "func": "const th  = flow.get('hum_th') ?? 60;   // threshold from the slider\nconst hys = 3;                           // hysteresis (avoids flicker)\nconst hum = parseFloat(msg.payload);\nif (isNaN(hum)) return null;\n\nconst prev = flow.get('alarm');\nlet on = prev === true;\nif (!on && hum > th)            on = true;\nelse if (on && hum < th - hys)  on = false;\n\nif (prev === on) return null;            // publish only when the state changes\nflow.set('alarm', on);\n\nreturn [\n  { payload: on ? '1' : '0' },           // -> board 2 (retained)\n  { payload: on ? `ALARM: humidity ${hum}% > ${th}%` : `Normal (${hum}%)` }\n];",
  "outputs": 2,
  "timeout": 0,
  "noerr": 0,
  "initialize": "",
  "finalize": "",
  "libs": [],
  "x": 380,
  "y": 120,
  "wires": [
   [
    "out_alarm",
    "dbg_cmd"
   ],
   [
    "txt_state"
   ]
  ]
 },
 {
  "id": "out_alarm",
  "type": "mqtt out",
  "z": "flow1",
  "name": "alarm -> board 2",
  "topic": "esp32/esp32_2/alarm",
