  "group": "ui_grp1",
  "order": 1,
  "width": 0,
  "height": 0,
  "passthru": true,
  "outs": "end",
  "topic": "threshold",
  "topicType": "str",
  "min": 30,
  "max": 90,
  "step": 1,
  "className": "",
  "x": 160,
  "y": 220,
  "wires": [
